{
  "permissions": {
    "deny": [
      "Read(./.recon-cache/**)",
      "Edit(./.recon-cache/**)",
      "Edit(./engine/include/openscanner/obscan_api.h)",
      "Edit(./tests/hardware/**)",
      "Bash(git push origin main:*)",
      "Bash(git push --force:*)"
    ],
    "ask": [
      "Bash(sudo:*)",
      "Bash(killall:*)",
      "Bash(pmset:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/guard-hw-run.sh"
          }
        ]
      }
    ]
  }
}

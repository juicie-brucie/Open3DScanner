<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>OpenScanner</string>
    <key>CFBundleDisplayName</key>
    <string>OpenScanner</string>
    <key>CFBundleIdentifier</key>
    <string>org.openscanner.app</string>
    <key>CFBundleVersion</key>
    <string>0.1.0</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleExecutable</key>
    <string>OpenScanner</string>
    <key>CFBundleIconFile</key>
    <string>OpenScanner</string>
    <key>LSMinimumSystemVersion</key>
    <string>11.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <!-- The UI is served by the local capture worker over plain HTTP on the
         loopback (http://127.0.0.1:<port>/). App Transport Security blocks
         cleartext loads to IP literals by default, which leaves the WKWebView
         blank/white; NSAllowsLocalNetworking permits loopback/.local loads
         without weakening ATS for anything else. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
    <!-- macOS 15+ gates access to the local network; the WebView reaches the
         capture worker over the loopback, and remote viewers connect over the
         LAN, so declare the use. -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>OpenScanner connects to the local capture server and streams the live scan to viewers on your network.</string>
</dict>
</plist>
